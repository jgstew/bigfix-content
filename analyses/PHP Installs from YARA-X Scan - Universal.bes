<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Analysis>
		<Title>PHP Installs from YARA-X Scan - Universal</Title>
		<Description><![CDATA[<P>Reports the results of the &quot;Scan for PHP Installs with YARA-X&quot; tasks (macOS, Linux, Windows), once a day: the distinct PHP versions found, how many PHP files were found, and when the scan ran. Each computer's full list (&quot;path&lt;TAB&gt;version&quot; per file) is in __BESData/__Global/Logs/yara_results_php.text. A computer that was scanned and has no PHP reports 0 files.</P>]]></Description>
		<Relevance><![CDATA[exists files whose(name of it as lowercase starts with "yara_results_php.text") of folders "Logs" of folders "__Global" of data folders of client]]></Relevance>
		<Source>Internal</Source>
		<SourceID>jgstew</SourceID>
		<SourceReleaseDate>2026-10-21</SourceReleaseDate>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Wed, 21 Oct 2026 14:58:28 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<Property Name="PHP Versions Found" ID="1" EvaluationPeriod="P1D"><![CDATA[unique values of following texts of lasts "%09" of lines of files whose(name of it as lowercase starts with "yara_results_php.text") of folders "Logs" of folders "__Global" of data folders of client]]></Property>
		<Property Name="PHP Files Found" ID="2" EvaluationPeriod="P1D"><![CDATA[(number of lines of it) of files whose(name of it as lowercase starts with "yara_results_php.text") of folders "Logs" of folders "__Global" of data folders of client]]></Property>
		<Property Name="PHP Scan Time" ID="3" EvaluationPeriod="P1D"><![CDATA[modification times of files whose(name of it as lowercase starts with "yara_results_php.text") of folders "Logs" of folders "__Global" of data folders of client]]></Property>
	</Analysis>
</BES>
