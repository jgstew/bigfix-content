<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Task>
		<Title>MDM: Wipe Computer: Erase Users and Data, Keep Provisioning (Repurpose) - Windows</Title>
		<Description><![CDATA[<P><B>Erases users and their data, keeps the organization's provisioning.</B> Use to repurpose a device for a new user. All user accounts, user data, apps and settings are removed. Provisioning packages (from %SystemDrive%\ProgramData\Microsoft\Provisioning, for example Wi-Fi, certificates or enrollment settings) are backed up first and applied again when the device restarts.</P>
<P>Uses the RemoteWipe CSP through the MDM Bridge WMI provider (root/cimv2/mdm/dmmap): it calls <B>doWipePersistProvisionedDataMethod</B> on the <B>MDM_RemoteWipe</B> class. Without provisioning packages on the device, this is the same as a full wipe.</P>
<P>Related: <I>Wipe Computer: Erase Everything (Lost, Stolen or Decommission) - MDM_RemoteWipe - Windows</I> keeps nothing; <I>MDM: Reset Windows: Keep User Files, Remove Apps (Repair) - Windows</I> keeps user accounts and files.</P>
<P>WARNING! This will wipe the system and cannot be undone. Target carefully.</P>
<P>Requires Windows 10, version 1511 or later, Pro, Enterprise or Education edition (the RemoteWipe CSP is not available on Home).</P>]]></Description>
		<Relevance>windows of operating system</Relevance>
		<Relevance>exists wmi "root/cimv2/mdm/dmmap"</Relevance>
		<Relevance><![CDATA[computer name = "WIN-ComputerNameToWipe" /* <-- Computer you want to wipe */]]></Relevance>
		<Category></Category>
		<DownloadSize>0</DownloadSize>
		<Source>Internal</Source>
		<SourceID>jgstew</SourceID>
		<SourceReleaseDate>2026-07-23</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Fri, 06 Nov 2026 15:05:55 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to deploy this action.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-PowerShell"><![CDATA[<#
.SYNOPSIS
    Wipes the device but persists provisioning data, via the RemoteWipe CSP (WMI-to-CSP bridge).

.DESCRIPTION
    Calls doWipePersistProvisionedDataMethod on the MDM_RemoteWipe class in root\cimv2\mdm\dmmap.
    Provisioning data is backed up, the device is wiped, and the data is restored on resume.

    Requirements:
      - Windows 10, version 1511 or later (doWipePersistProvisionedDataMethod)
      - Run from SYSTEM
#>

[CmdletBinding()]
param(
    [string]$OutFile
)

if (-not $OutFile) {
    try {
        $clientFolder = (Get-ItemProperty -Path "HKLM:\SOFTWARE\WOW6432Node\BigFix\EnterpriseClient\GlobalOptions" -Name "EnterpriseClientFolder" -ErrorAction Stop).EnterpriseClientFolder
    }
    catch {
        $clientFolder = "${env:ProgramFiles(x86)}\BigFix Enterprise\BES Client"
    }
    $OutFile = Join-Path $clientFolder "__BESData\__Global\Logs\MDM_RemoteWipe_PersistProvisionedData_Result.json"
}

# MDM_RemoteWipe is a singleton CSP node; select by ClassName.
$CimSplat = @{
    Namespace = "root\cimv2\mdm\dmmap"
    ClassName = "MDM_RemoteWipe"
}

try {
    $session  = New-CimSession
    $params   = New-Object Microsoft.Management.Infrastructure.CimMethodParametersCollection
    # RemoteWipe methods take an (empty) "param" input.
    $params.Add([Microsoft.Management.Infrastructure.CimMethodParameter]::Create("param", "", "String", "In"))
    $instance = Get-CimInstance @CimSplat
    $result   = $session.InvokeMethod($CimSplat.Namespace, $instance, "doWipePersistProvisionedDataMethod", $params)

    $result | ConvertTo-Json -Depth 10 | Out-File -FilePath $OutFile -Encoding UTF8
    exit 0
}
catch {
    Write-Error $_
    exit 1
}

# End of script]]></ActionScript>
		</DefaultAction>
	</Task>
</BES>
