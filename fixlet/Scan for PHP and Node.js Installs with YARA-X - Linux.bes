<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Task>
		<Title>Scan for PHP and Node.js Installs with YARA-X - Linux</Title>
		<Description><![CDATA[<P>Scans this computer for PHP installs, both package-managed and one-off (XAMPP, MAMP, Laragon, zips unpacked to a folder, static builds such as FrankenPHP), and for Node.js, both standalone (node, distro libnode) and embedded in other software (Electron apps, single-executable applications, vercel/pkg builds), and records the exact version of each. It uses <A href="https://github.com/VirusTotal/yara-x">YARA-X</A> with the rules from <A href="https://github.com/jgstew/tools/tree/master/YARA">jgstew/tools YARA</A>, PHP and Node.js in one pass; the version is read from strings compiled into the binaries, so nothing is run.</P><P>Results: one line per product found in a file, &quot;path&lt;TAB&gt;product&lt;TAB&gt;version&quot;, where product is php, node or electron (an Electron framework gets a node and an electron line; &quot;unknown&quot; for files such as PHP extensions or Node addons that carry no version), in __BESData/__Global/Logs/yara_results_runtimes.text. Activate the analysis &quot;PHP and Node.js Installs from YARA-X Scan - Universal&quot; to report them. The task becomes relevant again when the results are more than a day old.</P><P>Runs as root and scans every local disk filesystem (separate /home, /var, /opt, tmpfs /tmp, snaps); network shares, FUSE mounts, container storage, snapshots, files of 512 MB or more and non-executable file types are skipped.</P><P>The scan runs in the background (started with run, so the agent stays free for other actions) from __BESData/__Global/yara_runtime_scan and reads the whole disk, which can take 10-30 minutes or more. The action completes when the scan starts; the results file appears when it finishes, and its console output goes to __BESData/__Global/Logs/yara_scan_runtimes.log. While a scan is running the task is not relevant, so a second one is not started.</P>]]></Description>
		<Relevance><![CDATA[name of operating system as lowercase starts with "linux"]]></Relevance>
		<Relevance><![CDATA[exists (architecture of operating system) whose(it = "x86_64" OR it = "aarch64")]]></Relevance>
		<Relevance><![CDATA[exists file "/bin/bash"]]></Relevance>
		<Relevance><![CDATA[not in proxy agent context]]></Relevance>
		<Relevance><![CDATA[not exists files whose(name of it as lowercase starts with "yara_results_runtimes.text" AND (now - modification time of it) < 1*day ) of folders "Logs" of folders "__Global" of data folders of client]]></Relevance>
		<Relevance><![CDATA[not exists files whose(name of it = "scan.running" AND (now - modification time of it) < 12*hour) of folders "yara_runtime_scan" of folders "__Global" of data folders of client]]></Relevance>
		<Category></Category>
		<DownloadSize>10347394</DownloadSize>
		<Source>Internal</Source>
		<SourceID>jgstew</SourceID>
		<SourceReleaseDate>2026-10-25</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Mon, 26 Oct 2026 17:19:40 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to scan for PHP and Node.js installs.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
// Scan for PHP and Node.js installs and their versions with YARA-X - Linux
// Generated by YARA/make_bigfix_content.py from bash/yara_x_scan_linux.sh in
// https://github.com/jgstew/tools - change the script there and regenerate.

// yr (YARA-X CLI) release archive for this OS/CPU; the script still checks its SHA256
begin prefetch block
	if {architecture of operating system = "aarch64"}
		add prefetch item name=yara-x-v1.22.0-aarch64-unknown-linux-gnu.tar.gz sha1=fde88001e579387275f731387963dd220f7a6fbd size=9252173 url=https://github.com/VirusTotal/yara-x/releases/download/v1.22.0/yara-x-v1.22.0-aarch64-unknown-linux-gnu.tar.gz sha256=b1b90f0686ae3e9f607c07b743fd96d6283d9ea5e2fd764919b8505de8b63d4e
	endif
	if {architecture of operating system = "x86_64"}
		add prefetch item name=yara-x-v1.22.0-x86_64-unknown-linux-gnu.tar.gz sha1=f6e1f286242753e0e621c43da7f0c753c8ffc1f4 size=10347394 url=https://github.com/VirusTotal/yara-x/releases/download/v1.22.0/yara-x-v1.22.0-x86_64-unknown-linux-gnu.tar.gz sha256=7f470770b2c1a0d97f02298fc194978d999074d147d003d33dd62775761439db
	endif
end prefetch block

// Where the "path<TAB>product<TAB>version" results are copied to (read by the analysis):
parameter "destination_folder" = "{pathname of folders "Logs" of folders "__Global" of data folders of client}"
parameter "results_file" = "yara_results_runtimes.text"
// The scan runs in the background from here, not __Download: the client clears
// __Download when the action ends, and the scan outlives the action
parameter "temp_folder" = "{pathname of folders "__Global" of data folders of client}/yara_runtime_scan"

folder delete "{parameter "temp_folder"}"
folder create "{parameter "temp_folder"}"
copy "__Download/{name of file whose(name of it starts with "yara-x-v") of folder "__Download" of client folder of current site}" "{parameter "temp_folder"}/{name of file whose(name of it starts with "yara-x-v") of folder "__Download" of client folder of current site}"

// The scan script; every left curly brace in it is doubled, BigFix's escape for relevance substitution
delete __createfile
createfile until _END_OF_SCRIPT_
#!/usr/bin/env bash
#### Usage: ./yara_x_scan_linux.sh [-t TARGET_PATH] [-o OUTPUT_DIR] [-f text|json|ndjson] [-k] [-a YR_ARCHIVE] [-m MAX_MB] [-T THREADS] [-x DIR]... [-A]
#
# Self-contained YARA-X scan for Linux (Linux counterpart of yara_x_scan_macos.sh):
#   1. downloads the YARA-X CLI (yr) release for this CPU architecture
#   2. verifies the SHA256 of the download against a pinned value
#   3. unpacks it into a temporary folder
#   4. scans TARGET_PATH (recursively) with the YARA rule embedded below,
#      including every local disk filesystem mounted below it (separate
#      /home, /var, /opt, btrfs subvolumes, snaps, tmpfs /tmp); network shares,
#      FUSE mounts (rclone, sshfs), WSL Windows drives and system-only
#      filesystems (/proc, /sys, /dev, /run) are skipped
#   5. writes results + a log to OUTPUT_DIR; for text format:
#        yara_results_<host>_<time>.raw.text  full yr output (rules, meta, strings)
#        yara_results_<host>_<time>.text      "path<TAB>product<TAB>version",
#                                             one line per product in a file
#
#        product is php, node or electron; an Electron framework gets a node
#        and an electron line. Files matched with no version string, e.g.
#        Linux PHP extensions or Node addons, are listed with version
#        "unknown". Files whose names aren't valid
#        UTF-8, or whose paths contain control characters (newline, tab, ...),
#        are scanned as copies and shown as bash $'...' quoted paths (e.g.
#        $'/opt/app\351/php', $'/opt/new\nline/php').
#
# Run with sudo for a full scan; otherwise unreadable files are logged and skipped.
# Needs bash, coreutils, find, grep, sed, awk, tar + gzip, and curl or wget.
# yr is statically linked, so any glibc or musl distro works (kernel 3.2+ on
# x86_64, 3.7+ on aarch64).
#
# Options:
#   -t TARGET_PATH  file or folder to scan            (default: / = all local disks)
#   -o OUTPUT_DIR   folder to write results into      (default: ./yara_results)
#   -f FORMAT       yr output format: text|json|ndjson (default: text)
#   -k              keep the downloaded yr archive in OUTPUT_DIR, to reuse
#                   later with -a OUTPUT_DIR (its SHA256 is checked again)
#   -a YR_ARCHIVE   use a local yr release archive instead of downloading: the
#                   file, or a folder holding it under its release name (e.g. a
#                   BigFix prefetch folder); its SHA256 is still checked
#   -m MAX_MB       skip files of MAX_MB MB or larger, 0 = no limit
#                   (default: 512, or 0 with -A)
#   -T THREADS      yr scan threads                   (default: 1)
#   -x DIR          also skip this folder; repeat for more (a find -path
#                   pattern such as '*/node_modules' works too, but a
#                   filesystem mounted below a matching folder is still
#                   scanned: name its mount point with its own -x)
#   -A              no default skips: scan everything listed below as skipped
#                   by default (except empty files); -x still applies
#   -h              show this help
#
# Skipped by default (none of these can hold a likely host PHP or Node.js
# install; each skip is reported while running, files over the size cap and
# skipped mounts are listed in the log). To scan just one of these folders,
# target it (e.g. -t /var/lib/docker) instead of using -A:
#   - files of 512 MB or more: PHP builds are ~20 MB, the largest known
#     (FrankenPHP, static PHP in Go) ~180 MB, node 8.x-25.x 33-127 MB,
#     Electron frameworks 125-350 MB; this cuts VM disks, model weights, media
#   - images, media, archives, packages, documents, fonts, web/source/text
#     files, C headers, logs and databases: the rules only match executables
#     (by header); files with no extension, .so, .dll, .exe, .o are kept
#   - empty files
#   - container storage: /var/lib/docker, /var/lib/containers,
#     /var/lib/containerd, /var/lib/rancher, /var/lib/lxc, /var/lib/lxd,
#     /var/snap/lxd, ~/.local/share/containers - PHP or Node inside images
#     isn't a host install and repeats once per image layer
#   - snapshots: /.snapshots (snapper), /timeshift - full copies of the system
#     that would repeat every distro PHP and Node
# A skip whose folder contains TARGET_PATH is turned off automatically, and
# none apply when TARGET_PATH is a single file.
#
# find and yr run at low priority (nice 10, and ionice best-effort 7 where
# available) and yr uses 1 thread (-T 2 for faster scans), so a full scan doesn't take over the machine.
#
# Exit codes: 0 = scan ran, no matches; 1 = scan ran, matches found;
#             2 = usage error; 3 = download/verify/unpack error; 4 = scan error
#
# Release: https://github.com/VirusTotal/yara-x/releases/tag/v1.22.0
# SHA256 values below are the GitHub-computed asset digests for v1.22.0.
# Related: https://github.com/jgstew/tools/tree/master/YARA

set -euo pipefail

# Linux file names are raw bytes and need not be valid UTF-8. In a UTF-8 locale
# GNU grep calls such a file list "binary" and silently drops those lines, so a
# PHP at e.g. a Latin-1 path would never be scanned. The C locale keeps every byte.
export LC_ALL=C

YARAX_VERSION="1.22.0"
YARAX_BASE_URL="https://github.com/VirusTotal/yara-x/releases/download/v${{YARAX_VERSION}"
SHA256_AARCH64="b1b90f0686ae3e9f607c07b743fd96d6283d9ea5e2fd764919b8505de8b63d4e"
SHA256_X86_64="7f470770b2c1a0d97f02298fc194978d999074d147d003d33dd62775761439db"

TARGET_PATH="/"
OUTPUT_DIR="$PWD/yara_results"
OUTPUT_FORMAT="text"
KEEP_ARCHIVE=0
YR_ARCHIVE=""
MAX_MB=""
MAX_MB_SET=0
THREADS=1
EXCLUDE_DIRS=()
NO_SKIPS=0

# Extensions of files that can't start with an executable header, matched
# case-insensitively against the path end. The last line is Linux-only:
# packages, static libraries (ar archives here), git packs, journald, disk images,
# BigFix Fixlet files (.fxf, under the client's __BESData).
NONBINARY_EXT_RE='\.(jpg|jpeg|png|gif|heic|tif|tiff|bmp|webp|ico|icns|svg|svgz|mov|mp4|m4v|avi|mkv|mp3|m4a|aac|wav|aiff|caf|flac|pdf|zip|gz|tgz|xz|bz2|zst|7z|rar|dmg|pkg|xip|iso|jar|whl|docx|xlsx|pptx|doc|xls|ppt|pages|numbers|key|txt|md|rst|json|js|mjs|cjs|ts|tsx|jsx|map|css|scss|html|htm|xml|plist|strings|nib|car|py|pyc|rb|php|java|class|go|rs|c|cc|cpp|h|hpp|m|swift|yml|yaml|toml|ini|csv|tsv|log|sqlite|db|sqlite-wal|sqlite-shm|ttf|otf|woff|woff2|mo|po|lock|sum|'  # codespell:ignore caf
NONBINARY_EXT_RE+='deb|rpm|apk|tar|a|pack|idx|journal|wal|db-wal|db-shm|qcow2|img|vdi|vmdk|fxf)$'

CONTAINER_DIRS=( /var/lib/docker /var/lib/containers /var/lib/containerd /var/lib/rancher
                 /var/lib/lxc /var/lib/lxd /var/snap/lxd )
SNAPSHOT_DIRS=( /.snapshots /timeshift )

usage() {{
  awk 'NR > 1 && /^# Release:/ {{ exit } NR > 1 {{ sub(/^# ?/, ""); print }' "$0"
}

log() {{
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >&2
}

while getopts ":t:o:f:ka:m:T:x:Ah" opt; do
  case "$opt" in
    t) TARGET_PATH="$OPTARG" ;;
    o) OUTPUT_DIR="$OPTARG" ;;
    f) OUTPUT_FORMAT="$OPTARG" ;;
    k) KEEP_ARCHIVE=1 ;;
    a) YR_ARCHIVE="$OPTARG" ;;
    m) MAX_MB="$OPTARG"; MAX_MB_SET=1 ;;
    T) THREADS="$OPTARG" ;;
    x) [ "$OPTARG" = / ] && EXCLUDE_DIRS+=( / ) || EXCLUDE_DIRS+=( "${{OPTARG%/}" ) ;;
    A) NO_SKIPS=1 ;;
    h) usage; exit 0 ;;
    :) echo "Option -$OPTARG requires an argument." >&2; usage; exit 2 ;;
    \?) echo "Unknown option: -$OPTARG" >&2; usage; exit 2 ;;
  esac
done

case "$OUTPUT_FORMAT" in
  text|json|ndjson) ;;
  *) echo "Invalid format '$OUTPUT_FORMAT' (use text, json or ndjson)." >&2; exit 2 ;;
esac

# -A lifts the size cap too, unless -m is given
if [ "$MAX_MB_SET" -eq 0 ]; then
  [ "$NO_SKIPS" -eq 1 ] && MAX_MB=0 || MAX_MB=512
fi
SKIP_NONBINARY=$((1 - NO_SKIPS))
SKIP_CONTAINERS=$((1 - NO_SKIPS))
SKIP_SNAPSHOTS=$((1 - NO_SKIPS))

case "$MAX_MB" in
  ''|*[!0-9]*) echo "Invalid -m '$MAX_MB' (whole number of MB, 0 = no limit)." >&2; exit 2 ;;
esac

case "$THREADS" in
  ''|*[!0-9]*|0) echo "Invalid -T '$THREADS' (number of threads, 1 or more)." >&2; exit 2 ;;
esac

if [ "$(uname -s)" != "Linux" ]; then
  echo "This script is for Linux only (use yara_x_scan_macos.sh on macOS)." >&2
  exit 2
fi

# Minimal images (e.g. rockylinux:8) lack find; without this check a scan would
# list nothing and report "No matches"
MISSING=""
for c in find grep sed awk tar gzip sort wc mktemp; do
  command -v "$c" >/dev/null 2>&1 || MISSING="$MISSING $c"
done
if [ -n "$MISSING" ]; then
  echo "Missing required command(s):$MISSING (e.g. install findutils)" >&2
  exit 2
fi

if [ ! -e "$TARGET_PATH" ]; then
  echo "Target path does not exist: $TARGET_PATH" >&2
  exit 2
fi

case "$(uname -m)" in
  aarch64|arm64) ARCH="aarch64"; EXPECTED_SHA256="$SHA256_AARCH64" ;;
  x86_64|amd64)  ARCH="x86_64";  EXPECTED_SHA256="$SHA256_X86_64" ;;
  *) echo "Unsupported architecture: $(uname -m)" >&2; exit 2 ;;
esac

ASSET_NAME="yara-x-v${{YARAX_VERSION}-${{ARCH}-unknown-linux-gnu.tar.gz"
ASSET_URL="${{YARAX_BASE_URL}/${{ASSET_NAME}"

# GNU and BusyBox mktemp treat -t differently, so give a full template
if ! WORK_DIR="$(mktemp -d "${{TMPDIR:-/tmp}/yara_x_scan.XXXXXX")"; then
  echo "Cannot create a temporary folder in ${{TMPDIR:-/tmp}" >&2
  exit 3
fi
cleanup() {{ rm -rf "$WORK_DIR"; }
trap cleanup EXIT

# minimal images have no hostname command
HOST="$(hostname -s 2>/dev/null || uname -n)"
HOST="${{HOST%%.*}"

if ! mkdir -p "$OUTPUT_DIR"; then
  echo "Cannot create output folder: $OUTPUT_DIR" >&2
  exit 2
fi
TIMESTAMP="$(date '+%Y%m%d_%H%M%S')"
RESULT_BASE="${{OUTPUT_DIR}/yara_results_${{HOST}_${{TIMESTAMP}"
SUMMARY_FILE=""
if [ "$OUTPUT_FORMAT" = "text" ]; then
  RESULT_FILE="${{RESULT_BASE}.raw.text"
  SUMMARY_FILE="${{RESULT_BASE}.text"
else
  RESULT_FILE="${{RESULT_BASE}.${{OUTPUT_FORMAT}"
fi
LOG_FILE="${{OUTPUT_DIR}/yara_scan_${{HOST}_${{TIMESTAMP}.log"

# ---- download -------------------------------------------------------------
DOWNLOAD_RC=0
if [ -n "$YR_ARCHIVE" ]; then
  [ -d "$YR_ARCHIVE" ] && YR_ARCHIVE="${{YR_ARCHIVE%/}/${{ASSET_NAME}"
  if [ ! -f "$YR_ARCHIVE" ]; then
    log "ERROR: yr archive not found: $YR_ARCHIVE"
    exit 3
  fi
  log "Using local archive $YR_ARCHIVE"
  cp "$YR_ARCHIVE" "${{WORK_DIR}/${{ASSET_NAME}" || DOWNLOAD_RC=$?
elif command -v curl >/dev/null 2>&1; then
  log "Downloading $ASSET_URL"
  curl --fail --silent --show-error --location \
    --retry 3 --retry-delay 2 --connect-timeout 30 \
    --output "${{WORK_DIR}/${{ASSET_NAME}" "$ASSET_URL" || DOWNLOAD_RC=$?
elif command -v wget >/dev/null 2>&1; then
  log "Downloading $ASSET_URL"
  wget -q -T 30 -t 3 -O "${{WORK_DIR}/${{ASSET_NAME}" "$ASSET_URL" || DOWNLOAD_RC=$?
else
  log "ERROR: need curl or wget to download yr"
  exit 3
fi
if [ "$DOWNLOAD_RC" -ne 0 ]; then
  log "ERROR: download failed"
  exit 3
fi

# ---- verify ---------------------------------------------------------------
if command -v sha256sum >/dev/null 2>&1; then
  ACTUAL_SHA256="$(sha256sum "${{WORK_DIR}/${{ASSET_NAME}" | awk '{{print $1}')"
else
  ACTUAL_SHA256="$(shasum -a 256 "${{WORK_DIR}/${{ASSET_NAME}" | awk '{{print $1}')"
fi
if [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
  log "ERROR: SHA256 mismatch for $ASSET_NAME"
  log "  expected: $EXPECTED_SHA256"
  log "  actual:   $ACTUAL_SHA256"
  exit 3
fi
log "SHA256 verified: $ACTUAL_SHA256"

if [ "$KEEP_ARCHIVE" -eq 1 ]; then
  if [ -n "$YR_ARCHIVE" ]; then
    log "Not keeping the archive (-k): it is already local at $YR_ARCHIVE"
  # A failed copy only costs a download next time, so it doesn't stop the scan
  elif cp "${{WORK_DIR}/${{ASSET_NAME}" "${{OUTPUT_DIR}/${{ASSET_NAME}"; then
    log "Kept ${{OUTPUT_DIR}/${{ASSET_NAME} (reuse with -a $OUTPUT_DIR)"
  else
    log "WARNING: could not keep the archive in $OUTPUT_DIR"
  fi
fi

# ---- unpack ---------------------------------------------------------------
mkdir -p "${{WORK_DIR}/bin"
if ! tar -xzf "${{WORK_DIR}/${{ASSET_NAME}" -C "${{WORK_DIR}/bin"; then
  log "ERROR: failed to unpack $ASSET_NAME"
  exit 3
fi
YR="${{WORK_DIR}/bin/yr"
if [ ! -x "$YR" ]; then
  log "ERROR: yr binary not found in archive"
  exit 3
fi
# yr is static, so this only fails on a very old kernel or a noexec TMPDIR
if ! YR_VERSION="$("$YR" --version 2>&1)"; then
  log "ERROR: yr does not run here: $YR_VERSION"
  log "  (noexec ${{TMPDIR:-/tmp}? set TMPDIR to an exec-able folder)"
  exit 3
fi
log "Unpacked $YR_VERSION"

# ---- embedded YARA rule ---------------------------------------------------
# PHP and Node.js install detection + version, in one rule file so both are
# found in one scan. Copied from YARA/php/php_detect.yar and
# YARA/node/node_detect.yar by YARA/sync_rules.py - edit there, not here. The
# version is in the printed strings ($ver, $pv, $rel, $electron).
RULE_FILE="${{WORK_DIR}/embedded_rule.yar"
cat > "$RULE_FILE" <<'YARA_RULE'
/*
  PHP install detection + version, all OSes (Linux ELF, Windows PE, macOS Mach-O).

  Deliberately broad: PHP_Binary_Broad flags anything that looks PHP-related so
  nothing is missed; the other rules carry the exact version string. Run with
  `yara -s` (or `yr scan -s`) to print the matched version text.

  Rules:
    PHP_Runtime_Version     - PHP core runtime; $ver holds the exact version,
                              incl. distro suffix (e.g. 8.1.2-1ubuntu2.27)
    PHP_Windows_VersionInfo - any PE whose version resource says ProductName=PHP
                              (php.exe, php-cgi.exe, php8ts.dll, ext\php_*.dll);
                              $pv holds ProductVersion
    PHP_Binary_Broad        - catch-all: any executable with any PHP marker

  No modules are imported so the rules also work in embedded YARA engines
  (osquery, EDRs) that are built without the pe/elf/macho modules.

  See README.md for tested samples and the API number -> branch table.
*/

// Condition copied from is_executable.yar by sync_rules.py - edit it there
private rule PHP_Detect_IsExecutable
{{
  condition:
    // ELF executable (2) or shared object (3, also PIE executables); e_type is
    // in the byte order given by EI_DATA (1 = little, 2 = big endian)
    (uint32(0) == 0x464C457F and
      ((uint8(5) == 1 and (uint16(16) == 2 or uint16(16) == 3)) or
       (uint8(5) == 2 and (uint16be(16) == 2 or uint16be(16) == 3))))
    // PE: MZ header whose e_lfanew (0x3C) points at "PE\0\0"
    or (uint16(0) == 0x5A4D and uint32(uint32(0x3C)) == 0x00004550)
    // Mach-O 32/64 execute (2), dylib (6) or bundle (8, e.g. PHP extensions)
    or ((uint32(0) == 0xFEEDFACE or uint32(0) == 0xFEEDFACF) and
        (uint32(12) == 2 or uint32(12) == 6 or uint32(12) == 8))
    // same, byte-swapped (big-endian) Mach-O
    or ((uint32(0) == 0xCEFAEDFE or uint32(0) == 0xCFFAEDFE) and
        (uint32be(12) == 2 or uint32be(12) == 6 or uint32be(12) == 8))
    // Mach-O universal (CAFEBABE) with 1-19 architectures whose first slice
    // passes the thin Mach-O check above, so universal static libraries (.a),
    // object files and dSYMs are rejected. Java .class files also start with
    // CAFEBABE, but bytes 4-7 hold their class version (major >= 45), not an
    // architecture count. The header is big-endian; the first slice's offset
    // is at 16 (fat_arch.offset).
    or (uint32(0) == 0xBEBAFECA and uint32be(4) > 0 and uint32be(4) < 20 and
        (((uint32(uint32be(16)) == 0xFEEDFACE or uint32(uint32be(16)) == 0xFEEDFACF) and
          (uint32(uint32be(16) + 12) == 2 or uint32(uint32be(16) + 12) == 6 or
           uint32(uint32be(16) + 12) == 8)) or
         ((uint32(uint32be(16)) == 0xCEFAEDFE or uint32(uint32be(16)) == 0xCFFAEDFE) and
          (uint32be(uint32be(16) + 12) == 2 or uint32be(uint32be(16) + 12) == 6 or
           uint32be(uint32be(16) + 12) == 8))))
    // same for the rare 64-bit universal header (CAFEBABF): fat_arch_64.offset
    // is 8 bytes at 16; slices sit well below 4 GB, so its low half (20) is used
    or (uint32(0) == 0xBFBAFECA and uint32be(4) > 0 and uint32be(4) < 20 and
        (((uint32(uint32be(20)) == 0xFEEDFACE or uint32(uint32be(20)) == 0xFEEDFACF) and
          (uint32(uint32be(20) + 12) == 2 or uint32(uint32be(20) + 12) == 6 or
           uint32(uint32be(20) + 12) == 8)) or
         ((uint32(uint32be(20)) == 0xCEFAEDFE or uint32(uint32be(20)) == 0xCFFAEDFE) and
          (uint32be(uint32be(20) + 12) == 2 or uint32be(uint32be(20) + 12) == 6 or
           uint32be(uint32be(20) + 12) == 8))))
}

rule PHP_Runtime_Version
{{
  meta:
    description = "PHP core runtime (CLI/CGI/FPM/mod_php/libphp/php*ts.dll/php8.dll/embedded); $ver = exact version"
    confidence = "high"
  strings:
    // Compile-time literal "X-Powered-By: PHP/" PHP_VERSION in main/SAPI.c.
    // Present regardless of expose_php. Suffix covers distro builds (8.1.2-1ubuntu2.27)
    // and pre-releases (8.5.0RC1).
    $ver = /X-Powered-By: PHP\/[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]{{0,40}/
  condition:
    PHP_Detect_IsExecutable and $ver
}

rule PHP_Windows_VersionInfo
{{
  meta:
    description = "Windows PE with PHP version resource; $pv = ProductVersion (exact version)"
    confidence = "high"
  strings:
    // UTF-16LE "ProductName" <NUL + 0-2 bytes alignment pad> "PHP\0"
    $pname = {{ 50 00 72 00 6F 00 64 00 75 00 63 00 74 00 4E 00 61 00 6D 00 65 00 [2-4] 50 00 48 00 50 00 00 00 }
    $pv = /ProductVersion\x00[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.\-]{{0,20}/ wide
  condition:
    // A real PE (MZ + PE signature). #pv >= 0 is always true: $pv is only
    // there so -s prints the version
    uint16(0) == 0x5A4D and PHP_Detect_IsExecutable and $pname and #pv >= 0
}

rule PHP_Binary_Broad
{{
  meta:
    description = "Broad catch-all: executable containing any PHP runtime/extension marker"
    confidence = "medium"
  strings:
    $xpb    = "X-Powered-By: PHP/"
    $zend   = "Zend Engine v"
    // ZEND_MODULE_BUILD_ID, e.g. API20220829,NTS / API20250925,TS - also in extensions
    $api    = /API20[0-9]{{6},N?TS/
    $pname  = {{ 50 00 72 00 6F 00 64 00 75 00 63 00 74 00 4E 00 61 00 6D 00 65 00 [2-4] 50 00 48 00 50 00 00 00 }
    $grp    = "The PHP Group" ascii wide
    $ini    = "php.ini"
    $fmt    = "PHP %s (%s)"
  condition:
    PHP_Detect_IsExecutable and
    (
      $xpb or $zend or $api or $pname
      or ($grp and ($ini or $fmt))
    )
}

/*
  Node.js install detection + version, all OSes (Linux ELF, Windows PE, macOS Mach-O).

  Finds standalone node / node.exe, distro libnode, and Node embedded in other
  software (Electron, single-executable applications, vercel/pkg, apps that
  bundle libnode). Deliberately broad: Node_Binary_Broad flags anything that
  looks Node-related so nothing is missed; the other rules carry the exact
  version string. Run with `yara -s` (or `yr scan -s`) to print the matched
  version text.

  Rules:
    Node_Runtime_Version  - Node runtime or a runtime embedding Node; $ver holds
                            the exact version (node.js/v22.23.4), or for pkg
                            builds with no inspector $rel (the release URL)
    Node_Electron_Version - Electron framework; $electron holds Electron's
                            version, $ver the embedded Node version (none
                            in very old Electron, around 2.x)
    Node_Binary_Broad     - catch-all: any executable with any Node marker,
                            incl. native addons (.node) and the distro node
                            launchers that load libnode

  Bun is not detected and not excluded: Bun-compiled executables match only
  Node_Binary_Broad (an accepted false positive, reported with no version).

  No modules are imported so the rules also work in embedded YARA engines
  (osquery, EDRs) that are built without the pe/elf/macho modules.

  See README.md for tested samples and the ABI number -> Node major table.
*/

// Condition copied from is_executable.yar by sync_rules.py - edit it there
private rule Node_Detect_IsExecutable
{{
  condition:
    // ELF executable (2) or shared object (3, also PIE executables); e_type is
    // in the byte order given by EI_DATA (1 = little, 2 = big endian)
    (uint32(0) == 0x464C457F and
      ((uint8(5) == 1 and (uint16(16) == 2 or uint16(16) == 3)) or
       (uint8(5) == 2 and (uint16be(16) == 2 or uint16be(16) == 3))))
    // PE: MZ header whose e_lfanew (0x3C) points at "PE\0\0"
    or (uint16(0) == 0x5A4D and uint32(uint32(0x3C)) == 0x00004550)
    // Mach-O 32/64 execute (2), dylib (6) or bundle (8, e.g. PHP extensions)
    or ((uint32(0) == 0xFEEDFACE or uint32(0) == 0xFEEDFACF) and
        (uint32(12) == 2 or uint32(12) == 6 or uint32(12) == 8))
    // same, byte-swapped (big-endian) Mach-O
    or ((uint32(0) == 0xCEFAEDFE or uint32(0) == 0xCFFAEDFE) and
        (uint32be(12) == 2 or uint32be(12) == 6 or uint32be(12) == 8))
    // Mach-O universal (CAFEBABE) with 1-19 architectures whose first slice
    // passes the thin Mach-O check above, so universal static libraries (.a),
    // object files and dSYMs are rejected. Java .class files also start with
    // CAFEBABE, but bytes 4-7 hold their class version (major >= 45), not an
    // architecture count. The header is big-endian; the first slice's offset
    // is at 16 (fat_arch.offset).
    or (uint32(0) == 0xBEBAFECA and uint32be(4) > 0 and uint32be(4) < 20 and
        (((uint32(uint32be(16)) == 0xFEEDFACE or uint32(uint32be(16)) == 0xFEEDFACF) and
          (uint32(uint32be(16) + 12) == 2 or uint32(uint32be(16) + 12) == 6 or
           uint32(uint32be(16) + 12) == 8)) or
         ((uint32(uint32be(16)) == 0xCEFAEDFE or uint32(uint32be(16)) == 0xCFFAEDFE) and
          (uint32be(uint32be(16) + 12) == 2 or uint32be(uint32be(16) + 12) == 6 or
           uint32be(uint32be(16) + 12) == 8))))
    // same for the rare 64-bit universal header (CAFEBABF): fat_arch_64.offset
    // is 8 bytes at 16; slices sit well below 4 GB, so its low half (20) is used
    or (uint32(0) == 0xBFBAFECA and uint32be(4) > 0 and uint32be(4) < 20 and
        (((uint32(uint32be(20)) == 0xFEEDFACE or uint32(uint32be(20)) == 0xFEEDFACF) and
          (uint32(uint32be(20) + 12) == 2 or uint32(uint32be(20) + 12) == 6 or
           uint32(uint32be(20) + 12) == 8)) or
         ((uint32(uint32be(20)) == 0xCEFAEDFE or uint32(uint32be(20)) == 0xCFFAEDFE) and
          (uint32be(uint32be(20) + 12) == 2 or uint32be(uint32be(20) + 12) == 6 or
           uint32be(uint32be(20) + 12) == 8))))
}

rule Node_Runtime_Version
{{
  meta:
    description = "Node.js runtime (node, node.exe, libnode, or a runtime embedding Node: Electron, SEA, pkg); $ver = exact Node version"
    confidence = "high"
  strings:
    // Inspector /json/version "Browser" value: "node.js/" NODE_VERSION. In
    // every official build 8.17.0-25.9.0, distro libnode, Electron and SEA.
    // A suffix only after "-" (-rc.1, -nightly...): the compiler can merge the
    // literal with the next string (linux-x64 24.22.1: "v24.22.1Protocol-...")
    $ver = /node\.js\/v[0-9]{{1,2}\.[0-9]{{1,3}\.[0-9]{{1,3}(-[0-9A-Za-z.]{{1,20})?/
    // process.release.sourceUrl / headersUrl. Also in Bun (Node compatibility),
    // so it only counts together with the NODE_MODULE ABI symbol, which Bun
    // lacks; needed for vercel/pkg builds, which have no inspector string.
    // No "not Bun" exclusion: it could hide a real Node binary whose embedded
    // JavaScript mentions Bun.
    $rel = /https:\/\/nodejs\.org\/download\/release\/v[0-9]{{1,2}\.[0-9]{{1,3}\.[0-9]{{1,3}/
    // NODE_MODULE registration symbol, ABI = NODE_MODULE_VERSION (10.x and later)
    $abi = /node_register_module_v[0-9]{{2,3}/
  condition:
    Node_Detect_IsExecutable and ($ver or ($rel and $abi))
}

rule Node_Electron_Version
{{
  meta:
    description = "Electron framework (embeds Node.js); $electron = Electron version, $ver = embedded Node version"
    confidence = "high"
  strings:
    // Electron user agent. Both keep a "-" suffix (31.0.0-nightly.20240101), the
    // same as Node_Runtime_Version's $ver, so one file gives one node version
    $electron = /Electron\/[0-9]{{1,3}\.[0-9]{{1,3}\.[0-9]{{1,3}(-[0-9A-Za-z.]{{1,20})?/
    $ver = /node\.js\/v[0-9]{{1,2}\.[0-9]{{1,3}\.[0-9]{{1,3}(-[0-9A-Za-z.]{{1,20})?/
    // Old Electron (2.x) has no node.js/v, only the NODE_MODULE registration
    // function; it is then reported by its Electron version alone
    $reg = "node_module_register"
  condition:
    Node_Detect_IsExecutable and $electron and ($ver or $reg)
}

rule Node_Binary_Broad
{{
  meta:
    description = "Broad catch-all: Node runtime, libnode launcher, or native addon (.node)"
    confidence = "medium"
  strings:
    $ver    = "node.js/v"
    $rel    = "https://nodejs.org/download/release/v"
    $abi    = /node_register_module_v[0-9]{{2,3}/   // NODE_MODULE ABI, also in addons
    $napi   = "napi_register_module_v1"              // N-API addon export
    $napiim = "napi_module_register"                 // N-API addon import
    $start  = "_ZN4node5StartEiPPc"                  // distro launcher importing node::Start from libnode
    $reg    = "node_module_register"                 // NODE_MODULE: legacy (non-N-API) addons, old runtimes
  condition:
    // Also matches Bun-compiled executables (release URL, N-API): an accepted
    // false positive, reported as "node unknown"
    Node_Detect_IsExecutable and any of them
}
YARA_RULE

# ---- embedded version extractor (text format) -----------------------------
# Copied from YARA/versions.awk by YARA/sync_rules.py - edit there.
VERSIONS_AWK="${{WORK_DIR}/versions.awk"
cat > "$VERSIONS_AWK" <<'AWK_SCRIPT'
# Turn `yara -s` / `yr scan -s` output of php/php_detect.yar and
# node/node_detect.yar into "path<TAB>product<TAB>version", one line per
# product found in a file (product: php, node or electron):
#   yr scan -s -r php/php_detect.yar node/node_detect.yar /opt 2>/dev/null | awk -f versions.awk | sort -u
# Handles paths with spaces and the UTF-16 ProductVersion match ($pv), which
# yara prints with escaped NULs (8\x00.\x002\x00...). Matched files with no
# version string (e.g. Linux PHP extensions, Node addons) get "unknown".
# Versions: php from $ver / $pv; node from $ver (node.js/v...), or from $rel
# (the release URL) when no $ver matched; electron from $electron, so an
# Electron framework gets a node and an electron line.

# rule line: "<RULE> <path>", or with yr --print-meta "<RULE> [meta...] <path>"
/^(PHP|Node)_/ {{
  prod = /^PHP_/ ? "php" : "node"
  file = $0; sub(/^[^ ]+ /, "", file); sub(/^\[[^]]*\] /, "", file); seen[file SUBSEP prod] = 1; next
}

# string line: "0xOFFSET:$id: <matched text>"
/:\$(ver|pv|rel|electron): / {{
  v = $0; gsub(/\\x00/, "", v)
  id = v; sub(/: .*/, "", id); sub(/.*\$/, "", id)
  sub(/^[^ ]+ /, "", v)
  if (!match(v, /[0-9]+\.[0-9]+\.[0-9]+[0-9A-Za-z.+~_-]*/)) next
  v = substr(v, RSTART, RLENGTH)
  if (id == "electron") print file "\telectron\t" v
  else if (id == "rel") rel[file SUBSEP prod SUBSEP v] = 1
  else {{ print file "\t" prod "\t" v; versioned[file SUBSEP prod] = 1 }
}

END {{
  for (k in rel) {{
    split(k, a, SUBSEP)
    if (!((a[1] SUBSEP a[2]) in versioned)) {{ print a[1] "\t" a[2] "\t" a[3]; fromrel[a[1] SUBSEP a[2]] = 1 }
  }
  for (k in seen) {{
    split(k, a, SUBSEP)
    if (!(k in versioned) && !(k in fromrel)) print a[1] "\t" a[2] "\tunknown"
  }
}
AWK_SCRIPT

# ---- build list of files to scan ------------------------------------------
# yr has no "stay on one filesystem" option, so find builds the file list.
# Unlike macOS, Linux often spreads one system over several filesystems, so
# find gets one start point per local disk filesystem below TARGET_PATH and
# -xdev keeps each walk on its own filesystem (no network/FUSE/pseudo mounts,
# no double walks). /proc, /sys, /dev, /run, this script's own output/work
# folders (old results contain matched strings) and the default skips from the
# header are pruned. Paths are resolved with pwd -P (no symlinked prefixes).
if [ "$(id -u)" -ne 0 ]; then
  log "WARNING: not running as root - unreadable files will be skipped (see log)"
fi
# A failed cd would make set -e exit 1, which means "matches found"
OUTPUT_DIR_REAL="$(cd "$OUTPUT_DIR" && pwd -P)" || {{ log "ERROR: cannot enter $OUTPUT_DIR"; exit 2; }
WORK_DIR_REAL="$(cd "$WORK_DIR" && pwd -P)"
if [ -d "$TARGET_PATH" ]; then
  TARGET_REAL="$(cd "$TARGET_PATH" && pwd -P)" || {{ log "ERROR: cannot enter $TARGET_PATH"; exit 2; }
else
  TARGET_REAL="$(cd "$(dirname "$TARGET_PATH")" && pwd -P)/$(basename "$TARGET_PATH")" ||
    {{ log "ERROR: cannot enter the folder of $TARGET_PATH"; exit 2; }
fi
TARGET_PATH="$TARGET_REAL"

# path_within PATH DIR: PATH is DIR or somewhere below it ("/" contains everything)
path_within() {{ [ "$2" = / ] && return 0; case "$1/" in "$2"/*) return 0 ;; esac; return 1; }

# An explicitly named file is always scanned
NONEMPTY=( -size +0c )
if [ -f "$TARGET_PATH" ]; then
  MAX_MB=0; SKIP_NONBINARY=0; SKIP_CONTAINERS=0; SKIP_SNAPSHOTS=0; NONEMPTY=()
fi

if [ "$SKIP_CONTAINERS" -eq 1 ]; then
  for d in "${{CONTAINER_DIRS[@]}"; do
    path_within "$TARGET_PATH" "$d" && SKIP_CONTAINERS=0
  done
  case "$TARGET_PATH/" in */.local/share/containers/*) SKIP_CONTAINERS=0 ;; esac
fi
if [ "$SKIP_SNAPSHOTS" -eq 1 ]; then
  for d in "${{SNAPSHOT_DIRS[@]}"; do
    path_within "$TARGET_PATH" "$d" && SKIP_SNAPSHOTS=0
  done
fi

PRUNE_DIRS=( /proc /sys /dev /run "$OUTPUT_DIR_REAL" "$WORK_DIR_REAL" )
PRUNE=( -path /proc -o -path /sys -o -path /dev -o -path /run
        -o -path "$OUTPUT_DIR_REAL" -o -path "$WORK_DIR_REAL" )
if [ "$SKIP_CONTAINERS" -eq 1 ]; then
  PRUNE_DIRS+=( "${{CONTAINER_DIRS[@]}" )
  for d in "${{CONTAINER_DIRS[@]}"; do PRUNE+=( -o -path "$d" ); done
  PRUNE+=( -o -path '*/.local/share/containers' )
  log "Skipping container storage (target one with -t, or -A, to include)"
fi
if [ "$SKIP_SNAPSHOTS" -eq 1 ]; then
  PRUNE_DIRS+=( "${{SNAPSHOT_DIRS[@]}" )
  for d in "${{SNAPSHOT_DIRS[@]}"; do PRUNE+=( -o -path "$d" ); done
  log "Skipping filesystem snapshots (target one with -t, or -A, to include)"
fi
# -x: find prints resolved paths, so an existing folder is resolved like
# TARGET_PATH. A skip that is or contains TARGET_PATH would prune the whole
# walk, so like the other skips it is turned off. PRUNE_DIRS also keeps
# filesystems mounted below an excluded folder out (literal folders only).
# ${{a[@]+"${{a[@]}"}: bash before 4.4 calls an empty array unbound under set -u
for d in ${{EXCLUDE_DIRS[@]+"${{EXCLUDE_DIRS[@]}"}; do
  if [ -d "$d" ]; then d="$(cd "$d" && pwd -P)"; fi
  # $d unquoted on purpose: it may be a pattern such as */node_modules
  # shellcheck disable=SC2254
  case "$TARGET_PATH/" in ${{d%/}/*) log "Not skipping $d (-x): it contains $TARGET_PATH"; continue ;; esac
  PRUNE_DIRS+=( "$d" )
  PRUNE+=( -o -path "$d" )
  log "Skipping $d (-x)"
done

# Low priority for the walk and the scan; ionice is optional (util-linux)
LOW_PRIORITY=( nice -n 10 )
if command -v ionice >/dev/null 2>&1 && ionice -c 2 -n 7 true >/dev/null 2>&1; then
  LOW_PRIORITY+=( ionice -c 2 -n 7 )
fi

# Start points: TARGET_PATH, plus each local disk filesystem mounted below it.
# /proc/self/mountinfo: "id parent major:minor root mountpoint opts [optional...] - fstype source superopts";
# root/mountpoint escape space, tab, newline, backslash as octal (\040 ...).
ROOTS=( "$TARGET_PATH" )
if [ -d "$TARGET_PATH" ] && [ -r /proc/self/mountinfo ]; then
  MOUNTS_SKIPPED=0
  SEEN_MOUNTS=" "
  while IFS="$(printf '\t')" read -r fstype dev mroot mpoint; do
    [ "$mpoint" = "$TARGET_PATH" ] && continue
    path_within "$mpoint" "$TARGET_PATH" || continue
    [ -d "$mpoint" ] || continue  # single-file bind mounts, e.g. /etc/hosts in containers
    pruned=0
    for d in "${{PRUNE_DIRS[@]}"; do path_within "$mpoint" "$d" && pruned=1; done
    [ "$pruned" -eq 1 ] && continue
    case "$fstype" in
      ext2|ext3|ext4|xfs|btrfs|zfs|f2fs|jfs|reiserfs|bcachefs|vfat|exfat|ntfs|ntfs3) ok=1 ;;
      tmpfs)    case "$mpoint" in /tmp|/var/tmp) ok=1 ;; *) ok=0 ;; esac ;;
      squashfs) case "$mpoint" in /snap/*) ok=1 ;; *) ok=0 ;; esac ;;
      *) ok=0 ;;
    esac
    if [ "$ok" -eq 0 ]; then
      # pseudo/system filesystems are expected; log the rest (network, FUSE, ...)
      case "$fstype" in
        proc|sysfs|devtmpfs|devpts|tmpfs|ramfs|cgroup|cgroup2|securityfs|debugfs|tracefs|pstore|bpf|mqueue|hugetlbfs|configfs|fusectl|autofs|binfmt_misc|rpc_pipefs|nsfs|efivarfs|selinuxfs|overlay|squashfs) ;;
        *) echo "skipped mount ($fstype): $mpoint" >>"$LOG_FILE"; MOUNTS_SKIPPED=$((MOUNTS_SKIPPED + 1)) ;;
      esac
      continue
    fi
    # bind mounts repeat a filesystem (same device + root): walk it once
    case "$SEEN_MOUNTS" in *" $dev:$mroot "*) continue ;; esac
    SEEN_MOUNTS="$SEEN_MOUNTS$dev:$mroot "
    ROOTS+=( "$mpoint" )
  done < <(awk '
    function unesc(s) {{ gsub(/\\040/, " ", s); gsub(/\\011/, "\t", s); gsub(/\\012/, "\n", s); gsub(/\\134/, "\\", s); return s }
    {{ for (i = 7; i <= NF; i++) if ($i == "-") break
      printf "%s\t%s\t%s\t%s\n", $(i + 1), $3, unesc($4), unesc($5) }' /proc/self/mountinfo)
  if [ "${{#ROOTS[@]}" -gt 1 ]; then
    log "Also scanning $(( ${{#ROOTS[@]} - 1 )) local filesystem(s) mounted below $TARGET_PATH: ${{ROOTS[*]:1}"
  fi
  if [ "$MOUNTS_SKIPPED" -gt 0 ]; then
    log "Skipped $MOUNTS_SKIPPED network/FUSE/other mount(s) (listed in $LOG_FILE)"
  fi
fi

# Files at/over the cap are printed with a SKIPPED_SIZE tag, split out below.
# "{{} \;" not "{{} +": BusyBox find silently drops "+" inside -o; only big files
# reach this, so one printf per file is cheap.
SIZE_TEST=( -print )
if [ "$MAX_MB" -gt 0 ]; then
  SIZE_TEST=( \( -size -"$((MAX_MB * 1048576))"c -print -o -exec printf 'SKIPPED_SIZE\t%s\n' {{} \; \) )
  log "Skipping files of ${{MAX_MB} MB or more (use -m 0 to include)"
fi

SCAN_LIST="${{WORK_DIR}/scan_list.txt"
FIND_LIST="${{WORK_DIR}/find_list.txt"
# A newline (or other control character) in a path would break the one-path-
# per-line lists, so such paths go NUL-separated to their own list, copied below
CTRL_LIST="${{WORK_DIR}/ctrl_list.bin"
: >"$CTRL_LIST"
log "Listing files under $TARGET_PATH"
# shellcheck disable=SC2016  # $0/$1 are for the inner sh
"${{LOW_PRIORITY[@]}" find "${{ROOTS[@]}" -xdev \( "${{PRUNE[@]}" \) -prune \
  -o -type f ${{NONEMPTY[@]+"${{NONEMPTY[@]}"} \
  \( -path '*[[:cntrl:]]*' -exec sh -c 'printf "%s\0" "$1" >>"$0" || true' "$CTRL_LIST" {{} \; \
     -o "${{SIZE_TEST[@]}" \) >"$FIND_LIST" 2>>"$LOG_FILE" || true  # non-zero on permission errors

TAB=$'\t'
SIZE_SKIPPED="$(grep -c "^SKIPPED_SIZE${{TAB}" "$FIND_LIST" || true)"
if [ "$SIZE_SKIPPED" -gt 0 ]; then
  sed -n "s/^SKIPPED_SIZE${{TAB}/skipped (>= ${{MAX_MB} MB): /p" "$FIND_LIST" >>"$LOG_FILE"
  log "Skipped $SIZE_SKIPPED file(s) of ${{MAX_MB} MB or more (listed in $LOG_FILE)"
fi
if [ "$SKIP_NONBINARY" -eq 1 ]; then
  grep -v "^SKIPPED_SIZE${{TAB}" "$FIND_LIST" | grep -Eiv "$NONBINARY_EXT_RE" >"$SCAN_LIST" || true
  NONBINARY_SKIPPED=$(( $(wc -l <"$FIND_LIST") - SIZE_SKIPPED - $(wc -l <"$SCAN_LIST") ))
  log "Skipped $NONBINARY_SKIPPED non-executable file type(s) (use -A to include)"
else
  grep -v "^SKIPPED_SIZE${{TAB}" "$FIND_LIST" >"$SCAN_LIST" || true
fi

# yr --scan-list aborts at the first path that isn't valid UTF-8 ("stream did not
# contain valid UTF-8") and still exits 0, so one odd file name would silently
# empty the whole scan. Such files, and those with control characters in their
# paths, are scanned as ASCII-named copies in the work folder (a symlink loses
# the path in json output, a hard link would change the file's ctime), and their
# results show the bash $'...' quoted real path.
UTF8_SPLIT_AWK="${{WORK_DIR}/utf8_split.awk"
cat > "$UTF8_SPLIT_AWK" <<'AWK_SCRIPT'
# needs LC_ALL=C so awk sees bytes; valid lines to stdout, others to file "bad"
BEGIN {{
  t  = "[\200-\277]"
  u8 = "^([\001-\177]|[\302-\337]" t "|\340[\240-\277]" t "|[\341-\354\356\357]" t t "|\355[\200-\237]" t "|\360[\220-\277]" t t "|[\361-\363]" t t t "|\364[\200-\217]" t t ")*$"
}
{{ if ($0 ~ u8) print; else print > bad }
AWK_SCRIPT
NONUTF8_LIST="${{WORK_DIR}/nonutf8_list.txt"
COPY_MAP="${{WORK_DIR}/copy_map.txt"
: >"$NONUTF8_LIST"; : >"$COPY_MAP"
# Pure-ASCII paths (nearly all) are valid as-is; only the rest go through awk
HIGH_BYTE=$'[\x80-\xff]'
grep -v "$HIGH_BYTE" "$SCAN_LIST" >"${{SCAN_LIST}.utf8" || true
grep "$HIGH_BYTE" "$SCAN_LIST" | awk -v bad="$NONUTF8_LIST" -f "$UTF8_SPLIT_AWK" >>"${{SCAN_LIST}.utf8" || true
mv "${{SCAN_LIST}.utf8" "$SCAN_LIST"
COPIES=0
scan_as_copy() {{
  COPIES=$((COPIES + 1))
  local copy="${{WORK_DIR_REAL}/copies/${{COPIES}_"  # trailing _ so .../1_ never matches inside .../10_
  mkdir -p "${{WORK_DIR_REAL}/copies"
  # A reflink clone (btrfs, XFS) takes no extra space; BusyBox cp has no
  # --reflink, so fall back to a plain copy
  if ! {{ cp --reflink=auto "$1" "$copy" 2>/dev/null || cp "$1" "$copy" 2>>"$LOG_FILE"; }; then
    echo "unreadable (unusual name): $(printf '%q' "$1")" >>"$LOG_FILE"
    return 0
  fi
  echo "$copy" >>"$SCAN_LIST"
  printf '%s\t%q\n' "$copy" "$1" >>"$COPY_MAP"
}
while IFS= read -r p; do scan_as_copy "$p"; done <"$NONUTF8_LIST"
# Control-character paths skipped the size cap and extension filter in find
# (a folder name with a tab sends every file below it here), so apply both now
CTRL_SKIPPED=0
shopt -s nocasematch
while IFS= read -r -d '' p; do
  if [ "$SKIP_NONBINARY" -eq 1 ] && [[ ${{p##*/} =~ $NONBINARY_EXT_RE ]]; then
    CTRL_SKIPPED=$((CTRL_SKIPPED + 1))
    continue
  fi
  if [ "$MAX_MB" -gt 0 ] && [ "$(stat -c %s "$p" 2>/dev/null || echo 0)" -ge "$((MAX_MB * 1048576))" ]; then
    echo "skipped (>= ${{MAX_MB} MB): $(printf '%q' "$p")" >>"$LOG_FILE"
    CTRL_SKIPPED=$((CTRL_SKIPPED + 1))
    continue
  fi
  scan_as_copy "$p"
done <"$CTRL_LIST"
shopt -u nocasematch
if [ "$CTRL_SKIPPED" -gt 0 ]; then
  log "Skipped $CTRL_SKIPPED more file(s) with control characters in their paths (non-executable type or over the size cap)"
fi
if [ "$COPIES" -gt 0 ]; then
  log "$COPIES file(s) with unusual names (control characters, not UTF-8) are scanned as copies; results show them as \$'...' paths"
fi
log "Found $(wc -l <"$SCAN_LIST" | tr -d ' ') file(s) to scan"

# ---- scan -----------------------------------------------------------------
log "Scanning with $THREADS thread(s) at low priority..."
log "Results: $RESULT_FILE"
SCAN_RC=0
"${{LOW_PRIORITY[@]}" "$YR" scan --scan-list --print-meta --print-strings --threads "$THREADS" \
  --output-format "$OUTPUT_FORMAT" \
  "$RULE_FILE" "$SCAN_LIST" >"$RESULT_FILE" 2>>"$LOG_FILE" || SCAN_RC=$?

# find and yr report per-file errors (e.g. permission denied) on stderr; yr still
# scans the rest and exits 0, so non-zero means the scan itself failed
if [ "$SCAN_RC" -ne 0 ]; then
  log "ERROR: yr exited with code $SCAN_RC (see $LOG_FILE)"
  exit 4
fi
# safety net for the yr scan-list abort above (it exits 0)
if grep -q 'did not contain valid UTF-8' "$LOG_FILE" 2>/dev/null; then
  log "ERROR: yr stopped reading the file list (non-UTF-8 path); results are incomplete (see $LOG_FILE)"
  exit 4
fi

# Put the real (quoted) paths back in place of the copies
if [ -s "$COPY_MAP" ]; then
  awk -v map="$COPY_MAP" -v fmt="$OUTPUT_FORMAT" '
    BEGIN {{ FS = "\t"
            while ((getline line < map) > 0) {{
              i = index(line, "\t"); k = substr(line, 1, i - 1); v = substr(line, i + 1)
              if (fmt != "text") {{ gsub(/\\/, "\\\\", v); gsub(/"/, "\\\"", v) }  # JSON string escaping
              n++; from[n] = k; to[n] = v } }
    {{ for (j = 1; j <= n; j++)
        while ((p = index($0, from[j])) > 0) $0 = substr($0, 1, p - 1) to[j] substr($0, p + length(from[j]))
      print }' "$RESULT_FILE" >"${{RESULT_FILE}.tmp"
  mv "${{RESULT_FILE}.tmp" "$RESULT_FILE"
fi

if [ -n "$SUMMARY_FILE" ]; then
  awk -f "$VERSIONS_AWK" "$RESULT_FILE" | sort -u >"$SUMMARY_FILE"
  log "Versions: $SUMMARY_FILE ($(wc -l <"$SUMMARY_FILE" | tr -d ' ') line(s))"
fi

if [ -s "$LOG_FILE" ]; then
  log "$(wc -l <"$LOG_FILE" | tr -d ' ') skip/warning/error line(s) in $LOG_FILE"
else
  rm -f "$LOG_FILE"
fi

# Any output in text/ndjson mode means at least one match; json always prints an object
if [ "$OUTPUT_FORMAT" = "json" ]; then
  grep -q '"rule"\|"identifier"' "$RESULT_FILE" && MATCHED=1 || MATCHED=0
else
  [ -s "$RESULT_FILE" ] && MATCHED=1 || MATCHED=0
fi

if [ "$MATCHED" -eq 1 ]; then
  log "MATCHES FOUND - see $RESULT_FILE"
  exit 1
fi
log "No matches."
exit 0
_END_OF_SCRIPT_
copy __createfile "{parameter "temp_folder"}/yara_x_scan_linux.sh"

// The wrapper that runs it and copies the results to the destination folder
delete __createfile
createfile until _END_OF_SCRIPT_
#!/bin/bash
# Started by the BigFix task with "run": runs the scan in the background, then
# copies the summary to the Logs folder. scan.running marks a scan in progress
# (the task is not relevant while it exists).
T="{parameter "temp_folder"}"
D="{parameter "destination_folder"}"
touch "$T/scan.running"
/bin/bash "$T/yara_x_scan_linux.sh" -a "$T" -o "$T/results" >"$T/scan_console.log" 2>&1
rc=$?
echo "scan exit code: $rc (0 = no PHP or Node.js found, 1 = found, 2-4 = error)" >>"$T/scan_console.log"
mkdir -p "$D"
# Only a finished scan replaces the results; written under a temp name first so
# the analysis never reads a partial file
if [ "$rc" -le 1 ]; then
  for f in "$T"/results/yara_results_*.text; do
    case "$f" in *.raw.text) continue ;; esac
    cp "$f" "$D/.{parameter "results_file"}.tmp" && mv -f "$D/.{parameter "results_file"}.tmp" "$D/{parameter "results_file"}"
  done
fi
cp "$T/scan_console.log" "$D/yara_scan_runtimes.log"
rm -f "$T"/yara-x-v* "$T/scan.running"
_END_OF_SCRIPT_
copy __createfile "{parameter "temp_folder"}/run_scan.sh"

// Mark the scan as running before it starts, so the task isn't relevant again
// in the meantime (the wrapper removes the marker when the scan ends)
delete __createfile
createfile until _END_OF_SCRIPT_
started by action {id of action}
_END_OF_SCRIPT_
copy __createfile "{parameter "temp_folder"}/scan.running"

// Start the scan without waiting (it can take 10-30+ minutes): the action ends
// here and the client runs other actions. The results show up when it finishes.
run /bin/bash "{parameter "temp_folder"}/run_scan.sh"
]]></ActionScript>
			<SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
		</DefaultAction>
	</Task>
</BES>
