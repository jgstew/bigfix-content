<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Fixlet>
		<Title>Backup Windows Security Log</Title>
		<Description><![CDATA[<P>Backs up the Windows Security event log to C:\Windows\Temp\EventLogBackupSecurity.evt using a PowerShell call to the Win32_NTEventlogFile BackupEventlog method. Runs only when that backup file does not already exist; the existing backup must be removed or moved before the action will run again.</P> ]]></Description>
		<Relevance>windows of operating system</Relevance>
		<Relevance>not exists files "C:\Windows\Temp\EventLogBackupSecurity.evt"</Relevance>
		<Category></Category>
		<Source>Internal</Source>
		<SourceID></SourceID>
		<SourceReleaseDate>2019-11-21</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Thu, 21 Nov 2019 17:52:42 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to deploy this action.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
action uses wow64 redirection false

waithidden powershell -ExecutionPolicy Bypass -command "(Get-WmiObject Win32_NTEventlogFile -Filter \"LogFileName = 'Security'\").BackupEventlog(\"C:\Windows\Temp\EventLogBackupSecurity.evt\")"
]]></ActionScript>
		</DefaultAction>
	</Fixlet>
</BES>
