<?xml version="1.0"?>
<BES>
	<Wizard>
		<Title>Alert Group Warning</Title>
		<UIHooks LaunchType="Document" RequiresAuthoring="false" PostEvans="true"></UIHooks>
		<DefaultPage>Page1</DefaultPage>
		<Page Name="Page1">
			<Title>Alert Group Warning</Title>
			<HTML>
				<![CDATA[
					<style>
						body {
							margin: 0;
							padding: 0;
							width: 100%;
							font-family: Geneva, sans-serif;
						}

						.errorbox
						{
							font-family: Tahoma,Arial,sans-serif;
							font-size: 10pt;
							line-height: 1.25;
							color: #000;
							background-color: #ffffa9;
							border: solid 2px #ffe70c;
							padding: 3px 6px;
							font-weight: bold;
						}
					</style>

					<div id="alertBox" style="padding-bottom:4px;">
						<div class="errorbox">
							<div>
								<!-- TODO: replace with approved message text -->
								ALERT! Computer Errors!
							</div>
							<div style="font-weight:normal; font-size:9pt;">
								Count: <span id="alertCount">...</span>
								&ndash; <a id="detailsLink" href="linkid:openwizard(%7b%22CustomSiteName%22%3a%22Dashboards%22%7d,AlertGroupMembers.ojo)">View details</a>
							</div>
						</div>
					</div>

					<script>
						window.onload = function() {
							// The domain Condition already requires a 45-day check, so the box is always shown; this just fills in the count.
							try {
								var count = Relevance('number of members whose(now - last report time of it < 45*day) of bes computer groups whose(name of it starts with "Alert")');
								document.getElementById('alertCount').innerHTML = count;
							} catch (e) {
								document.getElementById('alertCount').innerHTML = '?';
							}
						};
					</script>
				]]>
			</HTML>
		</Page>
	</Wizard>
</BES>
