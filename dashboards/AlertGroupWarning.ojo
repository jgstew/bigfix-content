<?xml version="1.0"?>
<BES>
	<Wizard>
		<Title>Alert Group Warning</Title>
		<UIHooks LaunchType="Document" RequiresAuthoring="false" PostEvans="true"></UIHooks>
		<DefaultPage>Page1</DefaultPage>
		<Page Name="Page1">
			<Title>Alert Group Warning</Title>
			<HTML>
				<![CDATA[
					<style>
						body {
							margin: 0;
							padding: 0 0 4px 0;
							width: 100%;
							font-family: Geneva, sans-serif;
						}

						.errorbox
						{
							font-family: Tahoma,Arial,sans-serif;
							font-size: 12pt;
							color: #000;
							background-color: #ffffa9;
							border: solid 2px #ffe70c;
							padding: 5px;
							font-weight: bold;
						}
					</style>

					<div>
						<div class="errorbox">
							<div>
								<!-- TODO: replace with approved message text -->
								ALERT! Computers with Errors!
							</div>
							<div style="font-weight:normal; font-size:10pt;">
								Count: <span id="alertCount">...</span>
								&ndash; <a id="detailsLink" href="linkid:openwizard(%7b%22CustomSiteName%22%3a%22Dashboards%22%7d,AlertGroupMembers.ojo)">View details</a>
							</div>
						</div>
					</div>

					<script>
						window.onload = function() {
							// Same member filter as the domain Condition, but counted for display
							var count = Relevance('number of members whose(now - last report time of it < 45*day) of bes computer groups whose(name of it contains "Alert")');
							document.getElementById('alertCount').innerHTML = count;
						};
					</script>
				]]>
			</HTML>
		</Page>
	</Wizard>
</BES>
