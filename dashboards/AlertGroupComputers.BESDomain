<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!DOCTYPE Domains
[
	<!ENTITY % GeneralContentInclude SYSTEM "DomainContent.xml">
	<!ENTITY sitename ''>
	<!ENTITY sites 'current bes site'>
	<!ENTITY current_domain '(exists domain of it and domain of it is current domain)'>
	<!ENTITY % GeneralContentInclude SYSTEM "DomainContent.xml">
	%GeneralContentInclude;
]>
<Domains xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BESDomain_1_1.xsd">
	<Domain ID="&BESCDomainID;" Title="&BESCDomainTitle;">
		<Console Icon="&BESCConsoleIcon;" SortOrder="&BESCConsoleOrder;">
			<DomainBar>
				<!-- A tree node instead of a bar dashboard: it hides itself when empty, so no fixed-size blank slot -->
				<Tree SortOrder="-1">
					<List Title="Alert! Computers with ERRORS!" Type="Computer" HideIfEmpty="true" InitiallyExpanded="false">
						<FilterRelevance>set of members whose(now - last report time of it &lt; 45*day) of bes computer groups whose(name of it starts with "Alert")</FilterRelevance>
					</List>
				</Tree>
			</DomainBar>
		</Console>
	</Domain>
	<Domain ID="&BESDomainID;" Title="&BESDomainTitle;">
		<Console Icon="&BESConsoleIcon;" SortOrder="&BESConsoleOrder;">
			<DomainBar>
				<Tree SortOrder="-1">
					<List Title="Alert Group Computers" Type="Computer" HideIfEmpty="true" InitiallyExpanded="false">
						<FilterRelevance>set of members whose(now - last report time of it &lt; 45*day) of bes computer groups whose(name of it starts with "Alert")</FilterRelevance>
					</List>
				</Tree>
			</DomainBar>
		</Console>
	</Domain>
</Domains>
